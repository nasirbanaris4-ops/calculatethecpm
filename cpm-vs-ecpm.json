[{"endIndex":1,"sectionBreak":{"sectionStyle":{"columnSeparatorStyle":"NONE","contentDirection":"LEFT_TO_RIGHT","sectionType":"CONTINUOUS"}}},{"startIndex":1,"endIndex":53,"paragraph":{"elements":[{"startIndex":1,"endIndex":53,"textRun":{"content":"CPM vs eCPM: Key Differences, Formulas and Examples\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.pqdbwromimik","namedStyleType":"TITLE","direction":"LEFT_TO_RIGHT"}}},{"startIndex":53,"endIndex":334,"paragraph":{"elements":[{"startIndex":53,"endIndex":334,"textRun":{"content":"CPM means cost per 1,000 ad impressions. eCPM is the effective cost or revenue per 1,000 impressions, calculated from actual results. Publishers commonly use eCPM to measure ad earnings. To compare the two, check what the money represents and which impressions each report counts.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":334,"endIndex":575,"paragraph":{"elements":[{"startIndex":334,"endIndex":575,"textRun":{"content":"If you are comparing an advertiser dashboard with a publisher dashboard, matching dollar values are not guaranteed. Start by checking whether each report shows spend or revenue, amounts before or after fees, and the same set of impressions.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":575,"endIndex":602,"paragraph":{"elements":[{"startIndex":575,"endIndex":602,"textRun":{"content":"What CPM and eCPM tell you\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.uif6vzl9c9mn","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":602,"endIndex":906,"paragraph":{"elements":[{"startIndex":602,"endIndex":906,"textRun":{"content":"CPM stands for cost per mille, meaning cost per thousand. An advertiser may use a CPM price to plan an ad campaign or calculate the CPM actually achieved after delivery. Google Ads defines CPM bidding in terms of paying for 1,000 impressions. A bid or target is not automatically the final average cost.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":906,"endIndex":1158,"paragraph":{"elements":[{"startIndex":906,"endIndex":1158,"textRun":{"content":"The e in eCPM means effective. Google AdMob describes publisher eCPM as estimated earnings divided by ad impressions, multiplied by 1,000. This gives publishers a common basis for comparing revenue from different ad placements or advertising partners.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":1158,"endIndex":1419,"paragraph":{"elements":[{"startIndex":1158,"endIndex":1419,"textRun":{"content":"Do not treat “CPM equals advertisers, eCPM equals publishers” as an absolute rule. Reporting terminology varies. For this guide, advertiser CPM uses spend, while publisher eCPM uses revenue. Always read the definition beside the metric in the platform you use.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":1419,"endIndex":1662,"table":{"rows":4,"columns":3,"tableRows":[{"startIndex":1420,"endIndex":1461,"tableCells":[{"startIndex":1421,"endIndex":1430,"content":[{"startIndex":1422,"endIndex":1430,"paragraph":{"elements":[{"startIndex":1422,"endIndex":1430,"textRun":{"content":"Measure\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{"color":{"rgbColor":{"red":0.9098039,"green":0.93333334,"blue":0.9529412}}},"borderLeft":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"}}},{"startIndex":1430,"endIndex":1442,"content":[{"startIndex":1431,"endIndex":1442,"paragraph":{"elements":[{"startIndex":1431,"endIndex":1442,"textRun":{"content":"Money used\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{"color":{"rgbColor":{"red":0.9098039,"green":0.93333334,"blue":0.9529412}}},"borderLeft":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"}}},{"startIndex":1442,"endIndex":1461,"content":[{"startIndex":1443,"endIndex":1461,"paragraph":{"elements":[{"startIndex":1443,"endIndex":1461,"textRun":{"content":"Question answered\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"backgroundColor":{"color":{"rgbColor":{"red":0.9098039,"green":0.93333334,"blue":0.9529412}}},"borderLeft":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.850980