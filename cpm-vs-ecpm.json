":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"}}},{"startIndex":1548,"endIndex":1560,"content":[{"startIndex":1549,"endIndex":1560,"paragraph":{"elements":[{"startIndex":1549,"endIndex":1560,"textRun":{"content":"Ad revenue\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"borderLeft":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"}}},{"startIndex":1560,"endIndex":1597,"content":[{"startIndex":1561,"endIndex":1597,"paragraph":{"elements":[{"startIndex":1561,"endIndex":1597,"textRun":{"content":"What did 1,000 ad impressions earn?\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"borderLeft":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"}}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}},{"startIndex":1597,"endIndex":1661,"tableCells":[{"startIndex":1598,"endIndex":1608,"content":[{"startIndex":1599,"endIndex":1608,"paragraph":{"elements":[{"startIndex":1599,"endIndex":1608,"textRun":{"content":"Page RPM\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"borderLeft":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"}}},{"startIndex":1608,"endIndex":1628,"content":[{"startIndex":1609,"endIndex":1628,"paragraph":{"elements":[{"startIndex":1609,"endIndex":1628,"textRun":{"content":"Estimated earnings\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"borderLeft":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"}}},{"startIndex":1628,"endIndex":1661,"content":[{"startIndex":1629,"endIndex":1661,"paragraph":{"elements":[{"startIndex":1629,"endIndex":1661,"textRun":{"content":"What did 1,000 page views earn?\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}],"tableCellStyle":{"rowSpan":1,"columnSpan":1,"borderLeft":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderRight":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderTop":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"},"borderBottom":{"color":{"color":{"rgbColor":{"red":0.8509804,"green":0.8509804,"blue":0.8509804}}},"width":{"magnitude":0.5,"unit":"PT"},"dashStyle":"SOLID"}}}],"tableRowStyle":{"minRowHeight":{"unit":"PT"}}}],"tableStyle":{"tableColumnProperties":[{"widthType":"FIXED_WIDTH","width":{"magnitude":165.6,"unit":"PT"}},{"widthType":"FIXED_WIDTH","width":{"magnitude":165.6,"unit":"PT"}},{"widthType":"FIXED_WIDTH","width":{"magnitude":165.6,"unit":"PT"}}]}}},{"startIndex":1662,"endIndex":1705,"paragraph":{"elements":[{"startIndex":1662,"endIndex":1705,"textRun":{"content":"Compare the formulas using matching inputs\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.8n9xl4abseqh","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":1705,"endIndex":1766,"paragraph":{"elements":[{"startIndex":1705,"endIndex":1766,"textRun":{"content":"Advertiser CPM = advertising spend ÷ ad impressions × 1,000.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":1766,"endIndex":1820,"paragraph":{"elements":[{"startIndex":1766,"endIndex":1820,"textRun":{"content":"Publisher eCPM = ad revenue ÷ ad impressions × 1,000.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":1820,"endIndex":2104,"paragraph":{"elements":[{"startIndex":1820,"endIndex":2104,"textRun":{"content":"Both formulas express an amount of money per 1,000 impressions. Neither tells you how many purchases occurred or whether a campaign was profitable. Use a consistent reporting period and currency. If impressions are zero, the rate is undefined; showing a zero CPM would be misleading.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":2104,"endIndex":2140,"paragraph":{"elements":[{"startIndex":2104,"endIndex":2140,"textRun":{"content":"One campaign viewed from both sides\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.o98tol7lnxan","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":2140,"endIndex":2434,"paragraph":{"elements":[{"startIndex":2140,"endIndex":2434,"textRun":{"content":"Suppose an advertiser spends $600 for 120,000 impressions. Its actual CPM is $600 ÷ 120,000 × 1,000 = $5.00. For this hypothetical example, assume the publisher records those same 120,000 impressions and receives $480 after fees or other deductions. Its eCPM is $480 ÷ 120,000 × 1,000 = $4.00.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":2434,"endIndex":2712,"paragraph":{"elements":[{"startIndex":2434,"endIndex":2712,"textRun":{"content":"The $1 difference reflects the different money inputs in this example. It does not establish a standard fee, revenue share, or expected market rate. Real reports may also use different impression counts, so a gap between their rates cannot by itself identify a platform’s fees.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":2712,"endIndex":2714,"paragraph":{"elements":[{"startIndex":2712,"endIndex":2713,"inlineObjectElement":{"inlineObjectId":"kix.mks1lx2mt4la","textStyle":{}}},{"startIndex":2713,"endIndex":2714,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":2714,"endIndex":2802,"paragraph":{"elements":[{"startIndex":2714,"endIndex":2802,"textRun":{"content":"Illustrative example using the same 120,000 ad impressions; these are not market rates.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":2802,"endIndex":2969,"paragraph":{"elements":[{"startIndex":2802,"endIndex":2969,"textRun":{"content":"Check your own spend and impressions with the CPM calculator. For publisher revenue, use the eCPM calculator and keep the revenue basis consistent across comparisons.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":2969,"endIndex":2993,"paragraph":{"elements":[{"startIndex":2969,"endIndex":2992,"textRun":{"content":"Open the CPM calculator","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.019607844,"green":0.3882353,"blue":0.75686276}}},"link":{"url":"https://calculatethecpm.net/"}}}},{"startIndex":2992,"endIndex":2993,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":2993,"endIndex":3018,"paragraph":{"elements":[{"startIndex":2993,"endIndex":3017,"textRun":{"content":"Open the eCPM calculator","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.019607844,"green":0.3882353,"blue":0.75686276}}},"link":{"url":"https://calculatethecpm.net/ecpm-calculator"}}}},{"startIndex":3017,"endIndex":3018,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":3018,"endIndex":3075,"paragraph":{"elements":[{"startIndex":3018,"endIndex":3075,"textRun":{"content":"Why effective CPM helps compare different payment models\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.nxyfstvzy1g3","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":3075,"endIndex":3296,"paragraph":{"elements":[{"startIndex":3075,"endIndex":3296,"textRun":{"content":"An effective per-thousand rate can summarize results even when the underlying deal pays per click or action. InMobi describes publisher eCPM as a revenue measure that applies across buying methods, including CPC and CPA.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":3296,"endIndex":3643,"paragraph":{"elements":[{"startIndex":3296,"endIndex":3643,"textRun":{"content":"Imagine two hypothetical placements. Placement A earns $300 from 100,000 ad impressions, giving a $3 eCPM. Placement B earns $240 from 60,000 impressions, giving a $4 eCPM. B earns more per thousand impressions, while A earns more total revenue. Your decision depends on whether you are comparing earnings per impression, total earnings, or both.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":3643,"endIndex":3898,"paragraph":{"elements":[{"startIndex":3643,"endIndex":3898,"textRun":{"content":"Across the two placements, combined eCPM is $540 ÷ 160,000 × 1,000 = $3.375, or $3.38 rounded. The simple average of $3 and $4 is $3.50 and is incorrect here because the placements have different impression volumes. Add the revenue and impressions first.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":3898,"endIndex":3932,"paragraph":{"elements":[{"startIndex":3898,"endIndex":3932,"textRun":{"content":"Do not confuse eCPM with page RPM\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.3bhv0gxgq55t","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":3932,"endIndex":4203,"paragraph":{"elements":[{"startIndex":3932,"endIndex":4203,"textRun":{"content":"Page RPM uses page views rather than ad impressions. Google AdSense calculates it as estimated earnings divided by page views, multiplied by 1,000. A page can display more than one ad, so dividing by page views instead of ad impressions changes what the result measures.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":4203,"endIndex":4529,"paragraph":{"elements":[{"startIndex":4203,"endIndex":4529,"textRun":{"content":"For example, $200 earned across 50,000 page views produces a $4 page RPM. If those page views generated 100,000 recorded ad impressions, the impression-based revenue rate is $2 per thousand. Both calculations can be correct. They answer different questions, and neither rate should be substituted for the other in a forecast.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":4529,"endIndex":4582,"paragraph":{"elements":[{"startIndex":4529,"endIndex":4582,"textRun":{"content":"Make a fair comparison before changing your campaign\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.vw2lkj6jjfr0","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":4582,"endIndex":4901,"paragraph":{"elements":[{"startIndex":4582,"endIndex":4901,"textRun":{"content":"First, use matching reporting dates, time zones, currencies, and ad placements. Keep revenue before fees separate from revenue after fees. Check whether the figures are estimates or final amounts. Also check which impressions the report counts: ads delivered and ads that met viewability rules are not interchangeable.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":4901,"endIndex":5233,"paragraph":{"elements":[{"startIndex":4901,"endIndex":5233,"textRun":{"content":"Next, compare similar audiences and formats. A change in the mix of countries or placements can change a combined rate without proving that any individual placement improved. Keep US, UK, and other markets separate when investigating differences. A dollar CPM and a pound CPM cannot be compared as if the currencies were identical.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5233,"endIndex":5495,"paragraph":{"elements":[{"startIndex":5233,"endIndex":5353,"textRun":{"content":"Finally, check the outcome behind the rate. For advertisers, a lower CPM can still mean a high cost to win customers if ","textStyle":{}}},{"startIndex":5353,"endIndex":5380,"textRun":{"content":"few people click or convert","textStyle":{"underline":true,"foregroundColor":{"color":{"rgbColor":{"red":0.06666667,"green":0.33333334,"blue":0.8}}},"link":{"url":"https://calculatethecpm.net/ctr-calculator"}}}},{"startIndex":5380,"endIndex":5495,"textRun":{"content":". For publishers, higher eCPM can accompany fewer impressions and lower total revenue, as the example above shows.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5495,"endIndex":5528,"paragraph":{"elements":[{"startIndex":5495,"endIndex":5527,"textRun":{"content":"Read the CPM vs CPC vs CPA guide","textStyle":{"foregroundColor":{"color":{"rgbColor":{"red":0.019607844,"green":0.3882353,"blue":0.75686276}}},"link":{"url":"https://calculatethecpm.net/cpm-vs-cpc-vs-cpa"}}}},{"startIndex":5527,"endIndex":5528,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5528,"endIndex":5545,"paragraph":{"elements":[{"startIndex":5528,"endIndex":5545,"textRun":{"content":"Common questions\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.h4xb9ls40eco","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5545,"endIndex":5577,"paragraph":{"elements":[{"startIndex":5545,"endIndex":5577,"textRun":{"content":"Is eCPM always higher than CPM?\n","textStyle":{"bold":true,"fontSize":{"magnitude":12,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5577,"endIndex":5788,"paragraph":{"elements":[{"startIndex":5577,"endIndex":5788,"textRun":{"content":"No. Their relationship depends on the money and impression definitions. With identical inputs the formulas give identical rates. With different spend, revenue, or impression counts, either rate could be higher.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5788,"endIndex":5832,"paragraph":{"elements":[{"startIndex":5788,"endIndex":5832,"textRun":{"content":"Does a higher eCPM guarantee more earnings?\n","textStyle":{"bold":true,"fontSize":{"magnitude":12,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":5832,"endIndex":6008,"paragraph":{"elements":[{"startIndex":5832,"endIndex":6008,"textRun":{"content":"No. At a hypothetical $4 eCPM, 50,000 impressions generate $200. At $3 eCPM, 100,000 impressions generate $300. Compare both the rate and the volume before judging the result.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6008,"endIndex":6056,"paragraph":{"elements":[{"startIndex":6008,"endIndex":6056,"textRun":{"content":"Can I use eCPM to predict next month’s revenue?\n","textStyle":{"bold":true,"fontSize":{"magnitude":12,"unit":"PT"}}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6056,"endIndex":6303,"paragraph":{"elements":[{"startIndex":6056,"endIndex":6303,"textRun":{"content":"You can build a scenario: expected revenue = assumed eCPM × expected ad impressions ÷ 1,000. Treat both inputs as assumptions. The calculation does not predict future demand or guarantee that your rate and impression volume will remain unchanged.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6303,"endIndex":6305,"paragraph":{"elements":[{"startIndex":6303,"endIndex":6304,"pageBreak":{"textStyle":{}}},{"startIndex":6304,"endIndex":6305,"textRun":{"content":"\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6305,"endIndex":6338,"paragraph":{"elements":[{"startIndex":6305,"endIndex":6338,"textRun":{"content":"Publication details for approval\n","textStyle":{}}}],"paragraphStyle":{"headingId":"h.79a05dw6z1su","namedStyleType":"HEADING_1","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6338,"endIndex":6410,"paragraph":{"elements":[{"startIndex":6338,"endIndex":6410,"textRun":{"content":"Proposed SEO title: CPM vs eCPM: Key Differences, Formulas and Examples\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6410,"endIndex":6577,"paragraph":{"elements":[{"startIndex":6410,"endIndex":6577,"textRun":{"content":"Meta description: Understand CPM vs eCPM with clear formulas and worked examples. Compare ad spend, publisher earnings, and page RPM without mixing reporting metrics.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6577,"endIndex":6737,"paragraph":{"elements":[{"startIndex":6577,"endIndex":6737,"textRun":{"content":"Primary keyword: ecpm vs cpm. Supporting keyword: cpm vs ecpm. Related concepts: effective CPM, advertiser CPM, publisher revenue, ad impressions and page RPM.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6737,"endIndex":6905,"paragraph":{"elements":[{"startIndex":6737,"endIndex":6905,"textRun":{"content":"Intent: metric comparison and interpretation. The existing calculator pages retain quick calculation intent. This article does not replace the CPM vs CPC vs CPA guide.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}},{"startIndex":6905,"endIndex":7079,"paragraph":{"elements":[{"startIndex":6905,"endIndex":7079,"textRun":{"content":"All numerical campaign examples are illustrative, not benchmarks. No author credentials or first-hand testing claims have been invented. Publication requires owner approval.\n","textStyle":{}}}],"paragraphStyle":{"namedStyleType":"NORMAL_TEXT","direction":"LEFT_TO_RIGHT"}}}]

